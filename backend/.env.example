APP_ENV=development
APP_NAME=Article Publishing API
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://publishing_dev:replace-local-password@127.0.0.1:5432/publishing
MIGRATION_DATABASE_URL=postgresql+psycopg://publishing_dev:replace-local-password@127.0.0.1:5432/publishing
TEST_DATABASE_URL=postgresql+psycopg://publishing_dev:replace-local-password@127.0.0.1:5432/publishing_test
JWT_SIGNING_KEY=REPLACE_WITH_A_CRYPTOGRAPHIC_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=publishing-backend
JWT_AUDIENCE=publishing-frontend
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PUBLIC_APP_URL=http://localhost:3000
# Business defaults seed database settings; later changes use audited admin settings.
DEFAULT_REVIEW_DURATION_HOURS=120
DEFAULT_PUBLICATION_FEE_MINOR=250000
DEFAULT_CURRENCY=INR
DEFAULT_MAX_LIVE_ASSIGNMENTS=5
EXPIRY_SCAN_INTERVAL_SECONDS=60
REMINDER_BEFORE_DEADLINE_HOURS=24
OUTBOX_MAX_ATTEMPTS=8
WORKER_POLL_INTERVAL_SECONDS=5
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./var/private-files
MANUSCRIPT_MAX_BYTES=20971520
PAYMENT_PROOF_MAX_BYTES=10485760
SCANNER_DRIVER=clamav
SCANNER_HOST=127.0.0.1
SCANNER_PORT=3310
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=publishing@example.test
# Production object-store adapter parameters (provider-specific credentials injected separately).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
# Supply actual firm payment destination through protected admin settings before approval emails.

# Required in production: generate with Fernet.generate_key(); rotate with queued credentials drained.
OUTBOX_ENCRYPTION_KEY=
