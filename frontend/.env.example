# Specification defaults. Never put backend URLs/secrets in NEXT_PUBLIC_ variables.
APP_ORIGIN=http://localhost:3000
INTERNAL_APP_ORIGIN=http://127.0.0.1:3000
BACKEND_API_URL=http://127.0.0.1:8000
BFF_REQUEST_TIMEOUT_SECONDS=30
BFF_UPLOAD_TIMEOUT_SECONDS=120
BFF_MAX_UPLOAD_BYTES=20971520
COOKIE_SECURE=false
COOKIE_ACCESS_NAME=publishing_access
COOKIE_REFRESH_NAME=publishing_refresh
CSRF_COOKIE_NAME=publishing_csrf
# Set Secure=true and __Host- cookie names on HTTPS production origins.
LOG_LEVEL=INFO
